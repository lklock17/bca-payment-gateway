# ==============================================================================
# BCA PAYMENT GATEWAY - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Port & Mode (development | production)
PORT=3005
NODE_ENV=production

# Secret Key untuk Enkripsi JWT Session (isi string acak panjang >= 32 karakter di produksi)
JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter
JWT_EXPIRES_HOURS=24
BCRYPT_ROUNDS=10

# ------------------------------------------------------------------------------
# MANAJEMEN USER & ADMINISTRATOR (.env BOOTSTRAP & POLICY)
# ------------------------------------------------------------------------------
# Mode manajemen user:
# - hybrid   : Admin utama & seed user disinkronkan dari .env, user tambahan CRUD via Dashboard UI
# - env_only : Semua user hanya diatur dari .env (CRUD tambah/hapus user di UI dikunci)
# - db_only  : .env hanya dipakai saat instalasi DB pertama kali, selanjutnya dikelola via UI
USER_MANAGEMENT_MODE=hybrid

# Akun Administrator Utama (Menggantikan hardcoded admin@gateway.com / admin123)
ADMIN_EMAIL=admin@perusahaan-anda.com
ADMIN_PASSWORD=GantiDenganPasswordKuat!2026

# Jika true: setiap server restart, email & password admin utama di DB disamakan dengan .env
# Berguna untuk rotasi password atau pemulihan akses admin tanpa edit database manual.
ADMIN_SYNC_ON_BOOT=true

# Jika true dan NODE_ENV=production: server menolak start apabila ADMIN_PASSWORD kosong/default
STRICT_ENV_ADMIN=false

# Opsional: Daftar user tambahan (Admin cadangan / Kasir / Operator) dalam format JSON array
# Kosongkan [] jika user tambahan ingin dikelola melalui menu "Manajemen User" di Dashboard.
SEED_USERS_JSON=[]
# Contoh penggunaan:
# SEED_USERS_JSON='[{"email":"manager@toko.com","password":"PasswordMgr123","role":"admin"},{"email":"kasir1@toko.com","password":"PasswordKasir123","role":"user"}]'
SEED_USERS_SYNC=false

# Proteksi akun yang berasal dari .env agar email/password tidak dapat diubah/dihapus via Dashboard UI
LOCK_ENV_MANAGED_USERS=true

# ------------------------------------------------------------------------------
# KONFIGURASI BCA QRIS TERPUSAT (.env FALLBACK)
# ------------------------------------------------------------------------------
# Kredensial di bawah ini berfungsi sebagai fallback otomatis di tingkat server.
# Jika saat menambah atau mengedit merchant di Dashboard kolom kredensial dikosongkan,
# sistem akan otomatis menggunakan nilai konfigurasi .env ini sehingga:
# 1. Kredensial aman (tidak terekspos di UI / browser).
# 2. Tidak perlu mengetik ulang kredensial kasir & QRIS statis berulang kali.

# Username / Email Kasir KlikBCA (https://qr.klikbca.com/)
BCA_USER=kasir@toko-anda.com

# Password akun Kasir KlikBCA
BCA_PASS=PasswordKlikBCA123

# String Payload QRIS Statis BCA (EMVCo)
# Diperoleh dari QRIS cetak/statis BCA Merchant Anda. Sistem akan mengonversinya
# secara dinamis dengan menambahkan kode unik nominal otomatis pada setiap transaksi.
STATIC_QRIS=00020101021126610016ID.CO.BCA.WWW011893600014000000000002150000000000000005204581253033605802ID5912MERCHANT BCA6007JAKARTA61051234062070703A016304ABCD
